{
  "name": "creditscore-api",
  "version": "0.1.0",
  "description": "API server for CreditScoreMVP - read-only access to indexed events and on-chain data",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "cors": "^2.8.5",
    "creditscore-db": "workspace:*",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.18.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
