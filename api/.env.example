DATABASE_URL=postgresql://creditscore:devpass@localhost:5433/creditscore?schema=public
CC3_TESTNET_RPC=https://rpc.testnet.cc3.cloud
CC3_TESTNET_SOURCE_RPC=https://rpc.testnet.cc3.cloud
CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3001
LEADERBOARD_MAX_WALLETS=100

# --- Score sensitivity tuning (see db/src/scoreModel.ts) ---
# K controls rawScore sensitivity. Lower value = more sensitive to small transactions.
# Default for demo/testnet: 50 (more sensitive to dust amounts). 
# For production with real loan sizes, use 300.
# SCORE_SENSITIVITY_K=50

# --- Continuous Utilization (U) factor tuning (see db/src/scoreModel.ts) ---
# Points of uDrift lost per (USD of net outstanding debt * second) while
# in debt. Default for demo/testnet: a $10,000 unpaid debt costs ~1 uDrift-point/day.
# SCORE_DECAY_ALPHA=0.00000000116

# Points of uDrift gained per second while debt-free. Kept slow on purpose
# so recovery is gradual, not instant. Default for demo/testnet: slower recovery.
# SCORE_RECOVERY_BETA=0.0000000231

# Sensitivity constant for squashing uDrift into the [0,1] U factor via tanh.
# Lower value = more sensitive to small uDrift changes. Default for demo/testnet: 25.
# SCORE_UTILIZATION_K=25

# Compound Comet USDC pool address on Sepolia
COMPOUND_SEPOLIA_COMET_USDC=0xc3d688B66703497DAA19211EEdff47f25384cdc3

# Morpho Blue pool address on Sepolia
MORPHO_BLUE_SEPOLIA_ADDRESS=0xd011EE229E7459ba1ddd22631eF7bF528d424A14

# Aave WETHGateway address on Sepolia (for ETH deposit/withdraw operations)
AAVE_SEPOLIA_WETHGATEWAY=
