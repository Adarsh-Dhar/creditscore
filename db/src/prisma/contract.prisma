model IndexedEvent {
  id          Int      @id @default(autoincrement())
  txHash      String
  logIndex    Int
  blockNumber Int
  eventName   String
  wallet      String
  asset       String?
  amount      String
  chain       String   @default("sepolia")
  protocol    String   @default("aave")
  timestamp   Int?
  proven      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([wallet])
  @@index([proven])
  @@index([protocol])
}

model IndexerCheckpoint {
  id               Int      @id @default(autoincrement())
  chain            String
  contractAddress  String
  lastIndexedBlock Int
  updatedAt        temporal.updatedAt()

  @@unique([chain, contractAddress])
}

model RegisteredWallet {
  id         Int      @id @default(autoincrement())
  wallet     String   @unique
  points     Int      @default(0)
  createdAt  DateTime @default(now())
  lastSeenAt temporal.updatedAt()
}