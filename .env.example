# Copy this file to .env and fill in your own values. Never commit .env.

# Your wallet's private key, funded with:
#  - Sepolia ETH (for the source-chain side — only needed if you also plan
#    to create the Aave transaction yourself, not needed just to prove an
#    existing one)
#  - CC3 Testnet CTC (to pay gas for deploying + calling the contract on Creditcoin)
PRIVATE_KEY=

# Ethereum Sepolia RPC (e.g. from Infura, Alchemy, or a public endpoint)
SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_KEY

# Additional chains can be added by following the pattern:
# BASE_SEPOLIA_RPC=https://base-sepolia.infura.io/v3/YOUR_KEY
# POLYGON_AMOY_RPC=https://polygon-amoy.infura.io/v3/YOUR_KEY
# (Add corresponding entries in indexer/src/config.js CHAINS array)

# Creditcoin CC3 Testnet RPC — confirm this against current docs, it has changed before
CC3_TESTNET_RPC=https://rpc.cc3-testnet.creditcoin.network

# CC3 Testnet source RPC (if distinct from target-chain CC3_TESTNET_RPC)
# This is used when CC3 Testnet acts as a source chain for lending protocol events
CC3_TESTNET_SOURCE_RPC=https://rpc.cc3-testnet.creditcoin.network

# Lending protocol pool address on CC3 Testnet (for source chain indexing)
# This is the address of the lending protocol contract on CC3 Testnet to index
CC3_LENDING_POOL_ADDRESS=

# Attestcoin Proof Generation API endpoint (CC3 Testnet)
PROVER_API_URL=https://prover.cc3-testnet.creditcoin.network

# The deployed CreditScoreMVP contract address (fill in after running `npm run deploy`)
CONTRACT_ADDRESS=

# The wallet address you want credited with score (can be any address, e.g. your own)
TARGET_WALLET=

# The Aave (or any) transaction hash on Sepolia you want to prove happened.
# Find one yourself, e.g. by making one test Aave interaction on Sepolia,
# or by pulling any existing Aave Sepolia tx hash from a block explorer.
SOURCE_TX_HASH=

# Same Postgres as indexer/.env — used to look up event type for SOURCE_TX_HASH
DATABASE_URL="postgresql://creditscore:devpass@localhost:5433/creditscore?schema=public"

# Max unproven events to prove per run of `npm run prove-queue` (default: 10)
PROVE_BATCH_SIZE=10

# Auto-activity script settings (optional)
# Minutes between activity cycles (default: 5)
ACTIVITY_INTERVAL_MINUTES=5
# Enable Borrow/Repay in addition to Supply/Withdraw (default: false — see script for safety notes)
ACTIVITY_ENABLE_BORROW_REPAY=false
# Minimum Sepolia ETH balance to keep for gas before stopping (default: 0.01)
ACTIVITY_MIN_ETH_RESERVE=0.01
