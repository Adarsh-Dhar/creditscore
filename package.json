{
  "name": "creditscore-mvp",
  "version": "0.1.0",
  "description": "Minimal proof-of-concept: prove an Aave transaction on Ethereum Sepolia via Creditcoin's Attestcoin Protocol and increment an on-chain score.",
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js --network cc3Testnet",
    "prove": "node scripts/generateAndSubmitProof.js",
    "prove-queue": "node scripts/proveQueue.js",
    "check-score": "node scripts/checkScore.js",
    "aave": "node scripts/lib/aave.js",
    "aave:supply": "node scripts/lib/aave.js supply",
    "aave:borrow": "node scripts/lib/aave.js borrow",
    "aave:repay": "node scripts/lib/aave.js repay",
    "aave:withdraw": "node scripts/lib/aave.js withdraw",
    "aave:add-collateral": "node scripts/lib/aave.js add-collateral",
    "aave:remove-collateral": "node scripts/lib/aave.js remove-collateral",
    "aave:check-collateral": "node scripts/lib/checkCollateral.js",
    "compound": "node scripts/lib/compound.js",
    "compound:supply": "node scripts/lib/compound.js supply",
    "compound:withdraw": "node scripts/lib/compound.js withdraw",
    "morpho": "node scripts/lib/morpho.js",
    "morpho:supply": "node scripts/lib/morpho.js supply",
    "morpho:borrow": "node scripts/lib/morpho.js borrow",
    "morpho:repay": "node scripts/lib/morpho.js repay",
    "morpho:withdraw": "node scripts/lib/morpho.js withdraw",
    "morpho:add-collateral": "node scripts/lib/morpho.js add-collateral",
    "morpho:remove-collateral": "node scripts/lib/morpho.js remove-collateral",
    "index": "npm --prefix indexer run index",
    "api": "npm --prefix api run dev"
  },
  "dependencies": {
    "@gluwa/usc-sdk": "^0.18.0",
    "@gluwa/usc-contracts": "^0.1.2",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  }
}
