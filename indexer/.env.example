# Copy to .env and fill in. Never commit .env.

# Ethereum Sepolia RPC (same one used by the main creditscore repo)
# Infura free tier is rate-limited - consider alternatives:
# - Alchemy: https://www.alchemy.com/
# - QuickNode: https://www.quicknode.com/
# - Public RPCs (less reliable): https://chainlist.org/chain/11155111
SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_KEY

# CC3 Testnet source RPC (if CC3 Testnet acts as a source chain)
# This is used when CC3 Testnet has a lending protocol to index
CC3_TESTNET_SOURCE_RPC=https://rpc.cc3-testnet.creditcoin.network

# Lending protocol pool address on CC3 Testnet (for source chain indexing)
# This is the address of the lending protocol contract on CC3 Testnet to index
CC3_LENDING_POOL_ADDRESS=

# Block to start scanning from on the FIRST run only (ignored once
# checkpoint exists in database). Leave unset to start from the current tip.
START_BLOCK=

# Max block range per eth_getLogs call. Lower this if your RPC provider
# rejects wide ranges (common on free tiers).
INDEXER_CHUNK_SIZE=5000

# PostgreSQL database URL (for Docker Postgres)
DATABASE_URL="postgresql://creditscore:devpass@localhost:5433/creditscore?schema=public"
