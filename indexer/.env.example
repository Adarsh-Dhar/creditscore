# Copy to .env and fill in. Never commit .env.

# Ethereum Sepolia RPC (same one used by the main creditscore repo)
# Infura free tier is rate-limited - consider alternatives:
# - Alchemy: https://www.alchemy.com/
# - QuickNode: https://www.quicknode.com/
# - Public RPCs (less reliable): https://chainlist.org/chain/11155111
SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_KEY

# CC3 Testnet source RPC (if CC3 Testnet acts as a source chain)
# This is used when CC3 Testnet has a lending protocol to index
CC3_TESTNET_SOURCE_RPC=https://rpc.cc3-testnet.creditcoin.network

# Lending protocol pool address on CC3 Testnet (for source chain indexing)
# This is the address of the lending protocol contract on CC3 Testnet to index
CC3_LENDING_POOL_ADDRESS=

# Compound Comet USDC pool address on Sepolia
COMPOUND_SEPOLIA_COMET_USDC=0xc3d688B66703497DAA19211EEdff47f25384cdc3

# Morpho Blue pool address on Sepolia
MORPHO_BLUE_SEPOLIA_ADDRESS=0xd011EE229E7459ba1ddd22631eF7bF528d424A14

# Liquity V2 (ETH branch) on Sepolia — BorrowerOperations is what users call
# and what tx.to is validated against; TroveManager only emits the
# off-chain "something happened" signal the indexer scans/watches (see
# indexer/src/liquityDecoder.ts for why Liquity can't be decoded from event
# args the way the other protocols are).
LIQUITY_SEPOLIA_BORROWER_OPERATIONS=0x2377B5a07bdfA02812203BAB749E7bD43E4c596c
LIQUITY_SEPOLIA_TROVE_MANAGER=0x70fA06222e169329F7a2F386Ed70ad69A61228a5
LIQUITY_SEPOLIA_COLL_TOKEN=0x2442cA14d1217b4dD503e47DFdF79b774b56Ea89
LIQUITY_SEPOLIA_BOLD_TOKEN=0x620Ce1130f7c63457784CDfa31CFccBFB6be5029

# Aave WETHGateway address on Sepolia (for ETH deposit/withdraw operations)
AAVE_SEPOLIA_WETHGATEWAY=

# Block to start scanning from on the FIRST run only (ignored once
# checkpoint exists in database). Leave unset to start from the current tip.
START_BLOCK=

# Max block range per eth_getLogs call. Lower this if your RPC provider
# rejects wide ranges (common on free tiers).
INDEXER_CHUNK_SIZE=5000

# PostgreSQL database URL (for Docker Postgres)
DATABASE_URL="postgresql://creditscore:devpass@localhost:5433/creditscore?schema=public"

# --- Score sensitivity tuning (see db/src/scoreModel.ts) ---
# K controls rawScore sensitivity. Lower value = more sensitive to small transactions.
# Default for demo/testnet: 50 (more sensitive to dust amounts). 
# For production with real loan sizes, use 300.
# SCORE_SENSITIVITY_K=50

# --- Continuous Utilization (U) factor tuning (see db/src/scoreModel.ts) ---
# Points of uDrift lost per (USD of net outstanding debt * second) while
# in debt. Default for demo/testnet: a $10,000 unpaid debt costs ~1 uDrift-point/day.
# SCORE_DECAY_ALPHA=0.00000000116

# Points of uDrift gained per second while debt-free. Kept slow on purpose
# so recovery is gradual, not instant. Default for demo/testnet: slower recovery.
# SCORE_RECOVERY_BETA=0.0000000231

# Sensitivity constant for squashing uDrift into the [0,1] U factor via tanh.
# Lower value = more sensitive to small uDrift changes. Default for demo/testnet: 25.
# SCORE_UTILIZATION_K=25

# Points of uDrift gained per second while debt-free. Kept slow on purpose
# so recovery is gradual, not instant.
# SCORE_RECOVERY_BETA=0.000000231

# Sensitivity constant for squashing uDrift into the [0,1] U factor via tanh.
# SCORE_UTILIZATION_K=50

# --- Static price oracle overrides (see indexer/src/priceOracle.ts) ---
# Not a live price feed — a placeholder USD price table used to sum
# multi-asset debt into a single netOutstandingUSD figure. Override any
# symbol's price without a redeploy, e.g.:
# PRICE_USD_WETH=3200
# PRICE_USD_USDC=1
# PRICE_USD_UNKNOWN=1
